{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/onegayunicorn/conscious-subconscious/protocols/schemas/device-hello.schema.json",
  "title": "device.hello payload",
  "description": "Sent by a hardware adapter when it comes online, so a consumer can discover channels without hard-coding driver knowledge.",
  "type": "object",
  "additionalProperties": false,
  "required": ["device", "kind", "channels"],
  "properties": {
    "device": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "kind": {
      "type": "string",
      "enum": ["simulated", "serial", "lsl", "ble-heart-rate", "replay"],
      "description": "Driver kind. A consumer that does not recognise a kind must ignore the device rather than guess its semantics."
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 64 },
          "unit": { "type": "string", "maxLength": 24 },
          "nominal_rate_hz": { "type": "number", "minimum": 0 },
          "minimum": { "type": "number" },
          "maximum": { "type": "number" }
        }
      }
    },
    "sample_rate_hz": { "type": "number", "minimum": 0 },
    "bidirectional": {
      "type": "boolean",
      "description": "True only for adapters that can send a stimulus. Every shipped adapter is read-only with respect to the wearer."
    },
    "notes": { "type": "string", "maxLength": 512 }
  }
}
