apps/console/src/locales/
# Brand assets and catalogs are copied in from media/ and i18n/ by
# scripts/sync-assets.mjs in the site app.
apps/site/src/assets/
apps/site/src/locales/

# --- Local runtime state ---
*.sqlite3
*.db
runs/
out/
tmp/

# --- Secrets (never commit real values) ---
.env
.env.local
.env.*.local
!.env.example
*.pem
*.key
credentials.json

