# conscious-subconscious — environment template
#
# Copy to `.env` for local use. NEVER commit a real `.env`.
# Every variable here has a safe default in code; the file documents the knobs.

# ---------------------------------------------------------------------------
# API service
# ---------------------------------------------------------------------------
# Shared secret required in the `X-API-Key` header for every /v1 route.
# Leave EMPTY only for local development: when empty the service logs a loud
# warning and refuses to bind to a non-loopback interface.
CS_API_KEY=

# Bind address. Keep 127.0.0.1 for local work.
CS_HOST=127.0.0.1
CS_PORT=8080

# Comma-separated allow-list of browser origins. Never use `*` with credentials.
CS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Requests per minute per client, enforced by the in-process token bucket.
CS_RATE_LIMIT_PER_MINUTE=120

# Maximum accepted request body, in bytes.
CS_MAX_BODY_BYTES=1048576

# Log level: DEBUG | INFO | WARNING | ERROR
CS_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Simulation defaults
# ---------------------------------------------------------------------------
CS_DEFAULT_SEED=20260921
CS_DEFAULT_DT_HOURS=0.05
CS_DEFAULT_HORIZON_HOURS=72

# ---------------------------------------------------------------------------
# Device adapters (all optional)
# ---------------------------------------------------------------------------
# Serial bridge, e.g. /dev/ttyUSB0 or COM3
CS_SERIAL_PORT=
CS_SERIAL_BAUD=115200

# BLE heart-rate monitor: leave blank to scan and pick the first advertiser
CS_BLE_ADDRESS=

# Lab Streaming Layer stream name to resolve
CS_LSL_STREAM_NAME=conscious-subconscious
